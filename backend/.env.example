APP_NAME="Smart Campus Energy Optimization API"
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite:///./data/smart_campus_energy.db

# Groq AI Configuration (Recommended: ultra-fast sub-second latency)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI Fallback Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=8
SOLVER_TIMEOUT_SECONDS=5
API_TIMEOUT_SECONDS=29
